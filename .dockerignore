# VCS
.git

# Node / package managers
node_modules
**/node_modules
pnpm-store
.pnpm-store

# Python
.venv
__pycache__

# Build outputs / caches
.next
**/.next
.turbo
**/.turbo
out
coverage
*.log

# OS/editor junk
.DS_Store
*.swp
*.swo
.idea
.vscode

# Local env files (do not bake secrets). ** because bare patterns only match the context root.
**/*.env
**/.env
**/.env.*
!**/.env.example

# Database dumps and local credentials: COPY . . in Dockerfile.prod would pull them into the builder
backups
**/*.dump
**/*.pgdump
**/*.sql.gz
.overmind
.claude

# Docker
Dockerfile*
!.dockerignore

# Misc
*.local
_tmp
.tmp

