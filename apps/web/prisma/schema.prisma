  CREATE_TASK
  DELETE // Moves the thread to trash. Gated behind NEXT_PUBLIC_DELETE_EMAIL_ACTION_ENABLED.
  // SUMMARIZE
  // SNOOZE
  // ADD_TO_DO
  // INTEGRATION // for example, add to Notion
}

