// MCP Server OAuth 2.1 Models
// For when Inbox acts as an MCP Server (not client)

model McpServerClient {
  id        String   @id @default(cuid())
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  // Dynamic Client Registration (RFC 7591)
  clientId     String   @unique
  clientSecret String? // Public clients don't need secrets with PKCE
  clientName   String // e.g. "Claude Desktop", "VS Code"
  redirectUris String[] // Array of allowed redirect URIs

  // OAuth metadata
  grantTypes                  String[] @default(["authorization_code", "refresh_token"])
  responseTypes               String[] @default(["code"])
  tokenEndpointAuthMethod     String   @default("none") // Public client with PKCE
  scope                       String? // Space-separated scopes
  logoUri                     String?
  tosUri                      String?
  policyUri                   String?

  // A2A Protocol support
  type              ClientType @default(MCP) // MCP or A2A client
  userId            String? // For user-created A2A clients
  description       String? // Description of the client
  lastUsedAt        DateTime? // Track last usage

  // Relations
  authorizationCodes McpServerAuthorizationCode[]
  accessTokens       McpServerAccessToken[]
  user               User? @relation("McpServerClientToUser", fields: [userId], references: [id], onDelete: Cascade)

  @@index([clientId])
  @@index([userId])
  @@index([type])
}

model McpServerAuthorizationCode {
  id        String   @id @default(cuid())
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  expiresAt DateTime // 10 minute TTL

  code         String   @unique
  redirectUri  String
  scope        String? // Space-separated scopes requested
  state        String? // CSRF protection

  // PKCE (RFC 7636) - Mandatory in OAuth 2.1
  codeChallenge       String
  codeChallengeMethod String @default("S256")

  // User context
  userId         String
  user           User         @relation(fields: [userId], references: [id], onDelete: Cascade)
  emailAccountId String
  emailAccount   EmailAccount @relation(fields: [emailAccountId], references: [id], onDelete: Cascade)

  // Client context
  clientId     String
  client       McpServerClient @relation(fields: [clientId], references: [clientId], onDelete: Cascade)

  // Tracking
  used      Boolean  @default(false) // One-time use only
  usedAt    DateTime?

  @@index([code])
  @@index([expiresAt])
  @@index([userId])
  @@index([emailAccountId])
  @@index([clientId])
}

model McpServerAccessToken {
  id        String   @id @default(cuid())
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  expiresAt DateTime // 1 hour TTL for access tokens

  accessToken  String   @unique
  refreshToken String?  @unique // Optional refresh token for long-lived access
  tokenType    String   @default("Bearer")
  scope        String? // Space-separated scopes granted

  // User context
  userId         String
  user           User         @relation(fields: [userId], references: [id], onDelete: Cascade)
  emailAccountId String
  emailAccount   EmailAccount @relation(fields: [emailAccountId], references: [id], onDelete: Cascade)

  // Client context
  clientId     String
  client       McpServerClient @relation(fields: [clientId], references: [clientId], onDelete: Cascade)

  // Tracking
  revoked   Boolean  @default(false)
  revokedAt DateTime?
  lastUsedAt DateTime?

  @@index([accessToken])
  @@index([refreshToken])
  @@index([expiresAt])
  @@index([userId])
  @@index([emailAccountId])
  @@index([clientId])
}

