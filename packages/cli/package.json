{
  "name": "@inbox/cli",
  "version": "2.28.0",
  "description": "CLI tool for setting up and managing Inbox - AI email assistant",
  "type": "module",
  "bin": {
    "inbox": "bin/inbox.js"
  },
  "scripts": {
    "build": "bun build src/main.ts --outfile bin/inbox.js --target node",
    "prepublishOnly": "bun run build",
    "build:binary": "bun build src/main.ts --compile --outfile dist/inbox",
    "build:binary:all": "pnpm build:binary:macos-arm64 && pnpm build:binary:macos-x64 && pnpm build:binary:linux-x64",
    "build:binary:macos-arm64": "bun build src/main.ts --compile --target=bun-darwin-arm64 --outfile dist/inbox-darwin-arm64",
    "build:binary:macos-x64": "bun build src/main.ts --compile --target=bun-darwin-x64 --outfile dist/inbox-darwin-x64",
    "build:binary:linux-x64": "bun build src/main.ts --compile --target=bun-linux-x64 --outfile dist/inbox-linux-x64",
    "dev": "bun run src/main.ts",
    "test": "vitest run",
    "test:watch": "vitest"
  },
  "dependencies": {
    "@clack/prompts": "1.1.0",
    "commander": "14.0.3"
  },
  "devDependencies": {
    "@types/node": "24.10.1",
    "typescript": "5.9.3",
    "vitest": "4.0.18"
  },
  "files": [
    "bin"
  ],
  "engines": {
    "node": ">=18.0.0"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/elie222/inbox.git",
    "directory": "packages/cli"
  },
  "keywords": [
    "inbox",
    "email",
    "cli",
    "setup"
  ],
  "license": "SEE LICENSE IN ../../LICENSE"
}
